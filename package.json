{
  "name": "@raidou/pi-ask-user",
  "version": "0.1.3",
  "description": "Ask-user-question tool for pi: lets the agent present multiple-choice questions to the user.",
  "keywords": [
    "ask-user",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "question"
  ],
  "homepage": "https://github.com/weirongxu/pi-ask-user",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weirongxu/pi-ask-user.git"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "pnpm test:types && pnpm test:lint && pnpm test:unit",
    "test:types": "tsc --noEmit",
    "test:lint": "oxfmt --write && oxlint --fix",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@raidou/oxlint-config-base": "^0.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.1.2",
    "oxfmt": "^0.68.0",
    "oxlint": "1.83.0",
    "typebox": "1.3.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-tui": ">=0.85.0",
    "typebox": ">=1.1.38"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
