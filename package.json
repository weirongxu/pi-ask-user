{
  "name": "@raidou/pi-ask-user",
  "version": "0.1.0",
  "description": "Ask-user-question tool for pi: lets the agent present multiple-choice questions to the user.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "ask-user",
    "question"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "pnpm test:types && pnpm test:lint && pnpm test:unit",
    "test:types": "tsc --noEmit",
    "test:lint": "eslint --fix .",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@raidou/eslint-config-base": "4.4.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typebox": "1.1.38",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
